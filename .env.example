NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: login por usuario (lookup en perfiles) y avisos de reserva
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: secreto compartido con los workflows de n8n de aviso al cliente.
# Sin esto, confirmar/cancelar una reserva NO manda WhatsApp.
TOQUE_STATUS_WEBHOOK_SECRET=

# Solo servidor: resumen con IA en Reseñas y Consultas (OpenAI). Opcional: OPENAI_MODEL (por defecto gpt-4.1-mini).
OPENAI_API_KEY=
